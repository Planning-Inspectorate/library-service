# Ignore directories generated by Composer
/drush/contrib/
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/web/modules/contrib.tar.gz

# Custom theme source should be committed, but not build output/deps
/web/themes/custom/**/node_modules/
/web/themes/custom/**/package-lock.json
/web/themes/custom/**/sass/.sass-cache/
/web/themes/custom/**/.sass-cache/
web/themes/custom/*/js/*.bundle.js
web/themes/custom/*/js/*.bundle.js.map
web/themes/custom/*/js/govuk-frontend.min.js
web/themes/custom/*/js/govuk-frontend.min.js.map
web/themes/custom/*/gulp.log
web/themes/custom/*/node_modules/
web/themes/custom/*/package-lock.json

# Ignore sensitive information
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/services.yml
/web/sites/*/modules
/web/sites/*/themes
/web/sites/*/default.services.yml
/web/sites/*/default.setings.php


# Ignore Drupal's file directory
/web/sites/*/files
/web/sites/*/files/

# Ignore SimpleTest multi-site environment
/web/sites/simpletest

# Ignore files generated by common IDEs
/.idea/
/.vscode/

# Ignore .env files as they are personal
/.env
/.env.*
# Environment files anywhere, not just root
**/.env
**/.env.*

# Ignore dev and legacy environment
/docker-compose.yml
/docker.mk
/.github
/certs
/mariadb-init
/mnt
/tests
/Makefile
/traefik.yml
/README.md
/LICENSE
/LICENSE.md
/phpunit.xml.dist
/config/library

# Ignore azure blod directory
/config/azure/

# OS/WSL cruft
*:Zone.Identifier

/.ddev/

# Prevent accidental root-level npm artifacts (no root package.json exists)
/node_modules/
/package-lock.json

# DDEV-managed, auto-generated Drupal settings — regenerated on `ddev start`
/web/sites/default/settings.ddev.php
