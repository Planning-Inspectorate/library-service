<div class="govuk-header__logo govuk-header___logo">
  <a href="{{ path('<front>') }}" rel="home" class="govuk-header__homepage-link govuk-header__link" title="Home">
    <span class="govuk-header__logotype">
      <img src="{{ site_logo_url }}"  class="govuk-header__logotype-organisation-fallback-image" alt="Library home" />

      {% if site_slogan %}
        <span class="govuk-header__product-name">{{ site_slogan }}</span>
      {% endif %}
    </span>
  </a>
</div>

